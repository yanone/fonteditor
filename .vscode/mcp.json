{
  "servers": {
    "chromeDevtools": {
      "args": [
        "chrome-devtools-mcp",
        "--no-usage-statistics"
      ],
      "command": "npx",
      "type": "stdio"
    },
    "github": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "command": "npx"
    },
    "gortex": {
      "args": [
        "mcp",
        "--index",
        ".",
        "--watch"
      ],
      "command": "gortex",
      "env": {
        "GORTEX_INDEX_WORKERS": "8"
      }
    }
  }
}