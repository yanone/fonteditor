{
    "search.exclude": {
        "**/node_modules": true,
        "**/build": true,
        "**/target": true,
        "**/playwright-report": true,
        "**/test-results": true,
        "**/compilation-test/output": true,
        "**/wasm-dist": true,
        "**/.cache": true,
        "**/*.log": true,
        "**/*.wasm": true,
        "**/*.ttf": true,
        "**/*.otf": true,
        "**/*.woff": true,
        "**/*.woff2": true
    },
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/build/**": true,
        "**/target/**": true,
        "**/playwright-report/**": true,
        "**/test-results/**": true,
        "**/compilation-test/output/**": true,
        "**/wasm-dist/**": true,
        "**/.cache/**": true
    },
    "github.copilot.enable": {
        "*": true,
        "plaintext": false
    }
}
