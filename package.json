{
    "name": "counterpunch-font-editor",
    "version": "0.1.0",
    "description": "Counterpunch Font Editor",
    "type": "module",
    "scripts": {
        "dev:collab:local": "node scripts/dev-collab-local.mjs",
        "generate-api-docs": "node generate-api-docs.mjs",
        "generate-event-docs": "node generate-js-event-docs.mjs",
        "generate-glyph-filter-event-docs": "node generate-glyph-filter-event-docs.mjs",
        "generate-docs": "npm run generate-api-docs && npm run generate-event-docs && npm run generate-glyph-filter-event-docs",
        "check:graph-chokepoints": "node scripts/check-graph-chokepoints.mjs",
        "test:graph-chokepoints": "node --test tests/check-graph-chokepoints.test.mjs",
        "prepare": "husky"
    },
    "lint-staged": {
        "webapp/**/*.{js,ts,jsx,tsx,json,css,md,html,yml,yaml}": "webapp/node_modules/.bin/prettier --write"
    },
    "dependencies": {
        "typescript": "^5.0.0"
    },
    "devDependencies": {
        "gitnexus": "^1.6.3",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.6",
        "webpack-cli": "^7.0.2"
    }
}
