{
    "name": "counterpunch-font-editor",
    "version": "0.1.0",
    "description": "Counterpunch Font Editor",
    "type": "module",
    "scripts": {
        "dev:collab:local": "node scripts/dev-collab-local.mjs",
        "test:collab:local": "node scripts/test-collab-local.mjs",
        "generate-api-docs": "node generate-api-docs.mjs",
        "generate-event-docs": "node generate-js-event-docs.mjs",
        "generate-docs": "npm run generate-api-docs && npm run generate-event-docs",
        "prepare": "husky"
    },
    "lint-staged": {
        "webapp/**/*.{js,ts,jsx,tsx,json,css,md,html,yml,yaml}": "prettier --write"
    },
    "dependencies": {
        "typescript": "^5.0.0"
    },
    "devDependencies": {
        "chrome-devtools-mcp": "^0.21.0",
        "gitnexus": "^1.6.3",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.6",
        "prettier": "^3.8.3",
        "webpack-cli": "^7.0.2"
    }
}
