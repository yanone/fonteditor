    "openTypeFeatures":[
      {
        "feature":"languagesystem DFLT dflt;\nlanguagesystem latn dflt;\nlanguagesystem cyrl dflt;\nlanguagesystem latn ROM;\nlanguagesystem latn MOL;\nlanguagesystem latn CAT;\nlanguagesystem cyrl SRB;\nlanguagesystem cyrl BGR;\n\n"
      },
      {
        "name":"aalt",
        "feature":"feature aalt {\nfeature ccmp;\nfeature locl;\nfeature sups;\nfeature numr;\nfeature dnom;\nfeature frac;\nfeature ordn;\nfeature case;\nfeature salt;\nfeature ss01;\nfeature ss02;\nfeature ss03;\nfeature ss04;\nfeature ss05;\n} aalt;\n"
      },
      {
        "name":"ccmp",
        "feature":"feature ccmp {\nlookup ccmp_Other_1 {\n\t@CombiningTopAccents = [gravecomb];\n\tsub [i j]' @CombiningTopAccents by [idotless jdotless];\n\t@Markscomb = [gravecomb commaaccentcomb brevecomb-cy];\n\t@MarkscombCase = [gravecomb.case commaaccentcomb.case brevecomb-cy.case];\n\tsub @Markscomb @Markscomb' by @MarkscombCase;\n\tsub @Uppercase @Markscomb' by @MarkscombCase;\n} ccmp_Other_1;\n\nlookup ccmp_Other_2 {\n\tsub @Markscomb' @MarkscombCase by @MarkscombCase;\n\tsub @MarkscombCase @Markscomb' by @MarkscombCase;\n} ccmp_Other_2;\n} ccmp;\n"
      },
      {
        "name":"locl",
        "feature":"feature locl {\nscript latn;\nlanguage ROM;\nsub Scedilla by Scommaaccent;\nsub scedilla by scommaaccent;\nsub Tcedilla by Tcommaaccent;\nsub tcedilla by tcommaaccent;\nlanguage MOL;\nsub Scedilla by Scommaaccent;\nsub scedilla by scommaaccent;\nsub Tcedilla by Tcommaaccent;\nsub tcedilla by tcommaaccent;\nlanguage CAT;\nsub  l' periodcentered' l by ldot;\nsub  L' periodcentered' L by Ldot;\n\nscript cyrl;\nlanguage SRB;\nsub be-cy by be-cy.loclSRB;\nlanguage BGR;\nsub De-cy by De-cy.loclBGR;\nsub Ii-cy by Ii-cy.loclBGR;\nsub Iishort-cy by Iishort-cy.loclBGR;\nsub Iigrave-cy by Iigrave-cy.loclBGR;\nsub El-cy by El-cy.loclBGR;\nsub Ef-cy by Ef-cy.loclBGR;\nsub ve-cy by ve-cy.loclBGR;\nsub ge-cy by ge-cy.loclBGR;\nsub de-cy by de-cy.loclBGR;\nsub zhe-cy by zhe-cy.loclBGR;\nsub ze-cy by ze-cy.loclBGR;\nsub ii-cy by ii-cy.loclBGR;\nsub iishort-cy by iishort-cy.loclBGR;\nsub iigrave-cy by iigrave-cy.loclBGR;\nsub ka-cy by ka-cy.loclBGR;\nsub el-cy by el-cy.loclBGR;\nsub pe-cy by pe-cy.loclBGR;\nsub te-cy by te-cy.loclBGR;\nsub che-cy by che-cy.loclBGR;\nsub tse-cy by tse-cy.loclBGR;\nsub sha-cy by sha-cy.loclBGR;\nsub shcha-cy by shcha-cy.loclBGR;\nsub softsign-cy by softsign-cy.loclBGR;\nsub hardsign-cy by hardsign-cy.loclBGR;\nsub iu-cy by iu-cy.loclBGR;\n} locl;\n"
      },
      {
        "name":"sups",
        "feature":"feature sups {\nsub one by onesuperior;\nsub two by twosuperior;\nsub three by threesuperior;\nsub four by foursuperior;\n} sups;\n"
      },
      {
        "name":"numr",
        "feature":"feature numr {\nsub one by one.numr;\nsub two by two.numr;\nsub three by three.numr;\nsub four by four.numr;\n} numr;\n"
      },
      {
        "name":"dnom",
        "feature":"feature dnom {\nsub one by one.dnom;\nsub two by two.dnom;\nsub three by three.dnom;\nsub four by four.dnom;\n} dnom;\n"
      },
      {
        "name":"frac",
        "feature":"feature frac {\nsub one slash four by onequarter;\nsub one slash two by onehalf;\nsub three slash four by threequarters;\n} frac;\n"
      },
      {
        "name":"ordn",
        "feature":"feature ordn {\nsub [zero one two three four five six seven eight nine] [A a]' by ordfeminine;\nsub [zero one two three four five six seven eight nine] [O o]' by ordmasculine;\nsub N o period by numero;\n} ordn;\n"
      },
      {
        "name":"dlig",
        "feature":"feature dlig {\nsub t z by t_z;\n} dlig;\n"
      },
      {
        "name":"case",
        "feature":"feature case {\nsub gravecomb by gravecomb.case;\nsub commaaccentcomb by commaaccentcomb.case;\nsub brevecomb-cy by brevecomb-cy.case;\n} case;\n"
      },
      {
        "name":"liga",
        "feature":"feature liga {\nsub f f l by f_f_l;\nsub f f i by f_f_i;\nsub f i by fi;\nsub f f by f_f;\nsub f l by fl;\n} liga;\n"
      },
      {
        "name":"salt",
        "feature":"feature salt {\nsub g by g.ss01;\nsub ii-cy by ii-cy.ss01;\nsub iishort-cy by iishort-cy.ss01;\nsub iigrave-cy by iigrave-cy.ss01;\n} salt;\n"
      },
      {
        "name":"ss01",
        "feature":"feature ss01 {\nsub g by g.ss01;\nsub ii-cy by ii-cy.ss01;\nsub iishort-cy by iishort-cy.ss01;\nsub iigrave-cy by iigrave-cy.ss01;\n} ss01;\n"
      },
      {
        "name":"ss02",
        "feature":"feature ss02 {\nsub f by f.ss02;\n} ss02;\n"
      },
      {
        "name":"ss03",
        "feature":"feature ss03 {\nsub ampersand by ampersand.ss03;\n} ss03;\n"
      },
      {
        "name":"ss04",
        "feature":"feature ss04 {\nsub ampersand by ampersand.ss04;\n} ss04;\n"
      },
      {
        "name":"ss05",
        "feature":"feature ss05 {\nsub germandbls by germandbls.ss05;\nsub z by z.ss05;\nsub t_z by t_z.ss05;\n} ss05;\n"
      },
