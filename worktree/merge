#!/bin/bash
set -e

# Counterpunch worktree merge
# Usage: worktree/merge <feature-name>
#
# Merges the feature branch of a worktree into main, removes the
# worktree, and deletes the branch — all in one step.
# Can be run from anywhere inside the repo (main checkout or any worktree).

NAME="$1"
if [ -z "$NAME" ]; then
    echo "Usage: worktree/merge <feature-name>"
    echo ""
    echo "Merges the worktree branch 'feature/<name>' into main,"
    echo "then removes the worktree and deletes the branch."
    exit 1
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
BRANCH="feature/$NAME"
SAFE_NAME=$(echo "$NAME" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr -cd 'a-z0-9_-')
WORKTREE_PATH="$REPO_ROOT/../editor-$SAFE_NAME"

if ! git rev-parse --verify "$BRANCH" > /dev/null 2>&1; then
    echo "Error: Branch '$BRANCH' does not exist."
    exit 1
fi

echo "━━━ Merging '$BRANCH' into main ━━━"
echo ""

# --- Check worktree state and auto-commit if dirty ---
COMMIT_MSG="feature/$NAME"
if [ -d "$WORKTREE_PATH" ]; then
    echo "Worktree found at $WORKTREE_PATH"
    if git -C "$WORKTREE_PATH" status --porcelain | grep -q .; then
        echo "Worktree has uncommitted changes — auto-committing..."
        git -C "$WORKTREE_PATH" add -A
        git -C "$WORKTREE_PATH" commit -m "$COMMIT_MSG"
        echo "  Committed as: $COMMIT_MSG"
    fi
fi

# --- Fetch latest main ---
echo "Fetching latest main..."
git fetch origin main 2>/dev/null || true

# --- Merge ---
git checkout main

# --- Pre-check for conflicts ---
echo "Checking for merge conflicts..."
MERGE_CONFLICTS=false
DRY_RUN_OUTPUT=$(git merge --no-commit --no-ff "$BRANCH" 2>&1) || MERGE_CONFLICTS=true
git merge --abort 2>/dev/null

if [ "$MERGE_CONFLICTS" = true ]; then
    echo ""
    echo "⚠ Merge would produce conflicts."
    echo ""
    CONFLICT_FILES=$(echo "$DRY_RUN_OUTPUT" | grep "^CONFLICT" | sed 's/^CONFLICT ([^)]*) *//' | sed 's/Merge conflict in //' | sed 's/ *([^)]*)$//' | tr -d "'" | sed 's/^ *//;s/ *$//')
    if [ -n "$CONFLICT_FILES" ]; then
        echo "Conflicting files:"
        echo "$CONFLICT_FILES"
    fi
    echo ""
    echo "Force merge anyway? (y/N) "
    read CONFIRM
    if [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "Y" ]; then
        echo "Merge aborted."
        exit 1
    fi
    echo ""
    echo "Force-merging (conflict markers will be placed in working tree)..."
    if ! git merge --no-ff --no-commit "$BRANCH"; then
        echo ""
        echo "=== Merge is in progress with conflicts ==="
        echo "Resolve conflicts in: $REPO_ROOT"
        echo "After committing, clean up manually:"
        echo "  worktree/remove $NAME"
        exit 1
    fi
    # Restore main's versions of worktree-local files
    git checkout main -- webapp/worktree-config.json
    git commit -m "$COMMIT_MSG"
    echo ""
    echo "✓ Merge complete."
else
    # No conflicts — merge and restore worktree-local files before committing
    git merge --no-ff --no-commit "$BRANCH"
    git checkout main -- webapp/worktree-config.json
    git commit -m "$COMMIT_MSG"
    echo ""
    echo "✓ Merge complete."
fi

# --- Remove worktree ---
echo ""
echo "Removing worktree..."
if [ -d "$WORKTREE_PATH" ]; then
    git worktree remove "$WORKTREE_PATH" 2>/dev/null || {
        git worktree remove "$WORKTREE_PATH" --force 2>/dev/null || rm -rf "$WORKTREE_PATH"
        echo "  Worktree removed (forced): $WORKTREE_PATH"
    }
    echo "  Worktree removed: $WORKTREE_PATH"
else
    echo "  Worktree not found at $WORKTREE_PATH (already removed)."
fi

# --- Delete branch ---
echo ""
echo "Deleting branch '$BRANCH'..."
if git rev-parse --verify "$BRANCH" > /dev/null 2>&1; then
    git branch -d "$BRANCH"
    echo "  Branch deleted: $BRANCH"
else
    echo "  Branch already deleted."
fi

echo ""
echo "✓ Cleanup complete!"